              "raw": "{\n  \"houseId\": \"h1\",\n  \"type\": \"temperature\",\n  \"name\": \"Kitchen Temperature\",\n  \"serialNumber\": \"SN-2\",\n  \"location\": \"Kitchen\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Strangler Fig: датчик температуры, зарегистрированный в Device Service, дублируется в монолит (POST /api/v1/sensors), чтобы его видели клиенты старого API. legacySensorId — id датчика в монолите."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"legacySensorId\", pm.response.json().legacySensorId);",
                  "pm.test(\"Device Service создал датчик в монолите\", () => pm.expect(pm.response.json().legacySensorId).to.be.a(\"number\"));"
                ]
              }
            }
