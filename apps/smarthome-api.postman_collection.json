    {
      "name": "Sensors (монолит через gateway)",
      "item": [
        {
          "name": "Create Sensor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/sensors",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sensors"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Living Room Temperature\",\n  \"type\": \"temperature\",\n  \"location\": \"Living Room\",\n  \"unit\": \"°C\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"sensorId\", pm.response.json().id);",
                  "const s = pm.response.json();",
                  "pm.test(\"Поля сенсора\", () => { pm.expect(s.name).to.eql(\"Living Room Temperature\"); pm.expect(s.location).to.eql(\"Living Room\"); pm.expect(s.status).to.eql(\"inactive\"); pm.expect(s.id).to.be.a(\"number\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Sensors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/sensors",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sensors"
              ]
            },
            "description": "Для датчиков температуры монолит запрашивает текущее значение через telemetry-service, поэтому температура при каждом вызове разная, а история копится в Telemetry Service."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const s = pm.response.json().find(x => x.id == pm.collectionVariables.get(\"sensorId\"));",
                  "pm.test(\"Созданный сенсор в списке, температура от датчика\", () => { pm.expect(s).to.exist; pm.expect(s.value).to.be.within(18, 26); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Sensor by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/sensors/{{sensorId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sensors",
                "{{sensorId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Тот же сенсор\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"sensorId\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Temperature by Location",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/sensors/temperature/Living%20Room",
              "host": [
                "{{gatewayUrl}}"
