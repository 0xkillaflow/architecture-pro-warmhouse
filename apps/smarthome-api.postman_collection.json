{
  "info": {
    "name": "Warm House",
    "description": "Все запросы экосистемы «Тёплый дом» (MVP). Основные запросы идут через API Gateway (gatewayUrl). Запросы «Create ...» сохраняют id созданной сущности в переменные коллекции, поэтому папки удобно запускать по порядку (Run collection). Как запустить стек — apps/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "monolithUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "temperatureApiUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "deviceServiceUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "telemetryServiceUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "sensorId",
      "value": "1"
    },
    {
      "key": "deviceId",
      "value": "1"
    },
    {
      "key": "legacySensorId",
      "value": "1"
    }
  ],
  "item": [
    {
